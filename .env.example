# Vision model that reads plan photos: gemini-* (default gemini-3.5-flash), gpt-* or "fixture" (no key, answers from e2e/fixtures)
AI_API_KEY=
AI_MODEL=

# Supabase (also in Vercel). Leave both empty to keep projects in this browser only (localStorage + IndexedDB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: signs the photo URLs of the family view. Never prefix it with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Optional: absolute URL for share links and Open Graph tags; on Vercel the deploy URL is used when empty
NEXT_PUBLIC_SITE_URL=

# Supabase CLI on your machine only (migrations), never in Vercel. The ref is the subdomain of NEXT_PUBLIC_SUPABASE_URL
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
